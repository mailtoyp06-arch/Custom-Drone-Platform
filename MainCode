/* =====================================================================================
 * 3. SENSORS  --  IMU init + attitude estimation
 * -------------------------------------------------------------------------------------
 *  We use a COMPLEMENTARY FILTER (simpler and very robust vs a full Kalman filter):
 *    angle = COMP_ALPHA * (angle + gyroRate*dt)  +  (1-COMP_ALPHA) * accelAngle
 *  The gyro is trusted for fast motion; the accelerometer slowly corrects long-term drift.
 *  Yaw is left as a pure RATE (deg/s) from the gyro, which is all the yaw PID needs and
 *  avoids the noisy/drifty magnetometer heading.
 * ===================================================================================== */
void sensorsSetup() {
  if (lsm.begin()) {
    imuOK = true;
    lsm.setupAccel(lsm.LSM9DS1_ACCELRANGE_8G);
    lsm.setupMag(lsm.LSM9DS1_MAGGAIN_4GAUSS);
    lsm.setupGyro(lsm.LSM9DS1_GYROSCALE_2000DPS);
    Serial.println(F("[IMU] LSM9DS1 OK"));
  } else {
    imuOK = false;
    Serial.println(F("[IMU] *** LSM9DS1 NOT FOUND - flight disabled ***"));
  }
}

void readAttitude(float dt) {
  if (!imuOK) {
    angleRoll = anglePitch = 0;
    gyroRoll = gyroPitch = gyroYaw = 0;
    return;
  }

  sensors_event_t a, m, g, t;
  lsm.getEvent(&a, &m, &g, &t);

  // Calibrated accelerometer (m/s^2)
  float ax = a.acceleration.x - AX_OFFSET;
  float ay = a.acceleration.y - AY_OFFSET;
  float az = a.acceleration.z - AZ_OFFSET;

  // Calibrated gyro. Adafruit returns rad/s -> convert to deg/s, then remove the bias
  // measured at boot (gyroBias*), so a stationary craft reads ~0 deg/s (no drift).
  gyroRoll = (g.gyro.y * 180.0 / PI) - gyroBiasRoll;    // about X (roll)
  gyroPitch = (g.gyro.x * 180.0 / PI) - gyroBiasPitch;  // about Y (pitch)
  gyroYaw = (g.gyro.z * 180.0 / PI) - gyroBiasYaw;      // about Z (yaw)

  // Angle from the accelerometer (gravity vector). Valid only when not accelerating hard.
  // We subtract the resting angle measured at boot (levelOff*) so a level craft reads 0.
  float accRoll = (atan2(ax, az) * 180.0 / PI) - levelOffRoll;
  float accPitch = (atan2(-ay, sqrt(ay * ay + az * az)) * 180.0 / PI) - levelOffPitch;
  // Complementary fusion: gyro for fast motion, accel to slowly correct drift.
  angleRoll = COMP_ALPHA * (angleRoll + gyroRoll * dt) + (1.0 - COMP_ALPHA) * -accRoll;
  anglePitch = COMP_ALPHA * (anglePitch + gyroPitch * dt) + (1.0 - COMP_ALPHA) * -accPitch;

  // ---- Compass heading (for AUTONOMOUS navigation only) ----------------------------
  // Apply hard-iron offset + soft-iron matrix, then tilt-compensate with roll/pitch so
  // the heading stays correct while the craft leans.
  float mxu = m.magnetic.x - MX_OFFSET;
  float myu = m.magnetic.y - MY_OFFSET;
  float mzu = m.magnetic.z - MZ_OFFSET;
  float Mx = MAG_M[0][0] * mxu + MAG_M[0][1] * myu + MAG_M[0][2] * mzu;
  float My = MAG_M[1][0] * mxu + MAG_M[1][1] * myu + MAG_M[1][2] * mzu;
  float Mz = MAG_M[2][0] * mxu + MAG_M[2][1] * myu + MAG_M[2][2] * mzu;
  float rollRad = angleRoll * PI / 180.0;
  float pitchRad = -anglePitch * PI / 180.0;
  float Xh = Mx * cos(pitchRad) + My * sin(rollRad) * sin(pitchRad) + Mz * cos(rollRad) * sin(pitchRad);
  float Yh = My * cos(rollRad) - Mz * sin(rollRad);
  float h = atan2(Yh, Xh) * 180.0 / PI + HEADING_OFFSET_DEG;
  while (h < 0) h += 360.0;
  while (h >= 360) h -= 360.0;
  headingDeg = h;  // TRUE heading (navigation uses this)

  // Yaw relative to the power-on heading, so the reported/telemetry yaw reads ~0 at
  // startup (what you asked for). Navigation still uses the true headingDeg above.
  float ry = headingDeg - yawRef;
  while (ry > 180) ry -= 360;
  while (ry < -180) ry += 360;
  reportedYaw = ry;
}

/* =====================================================================================
 * 3b. STARTUP AUTO-CALIBRATION + STATUS SIGNALLING
 * -------------------------------------------------------------------------------------
 *  On boot, with the craft still and level, average the IMU to learn:
 *    - the gyro bias (deg/s) on each axis, so rates read 0 at rest (no yaw drift),
 *    - the resting roll/pitch angle, so the attitude reads 0 when level,
 *    - the current compass heading, used as the "yaw = 0" reference.
 *  Feedback:  onboard LED (fast blink = calibrating, solid = ready) and, if you fit a
 *  buzzer on PIN_BUZZER, one tone at the start and a rising double-tone when ready.
 * ===================================================================================== */
void signalSetup() {
  pinMode(PIN_STATUS_LED, OUTPUT);
  digitalWrite(PIN_STATUS_LED, LOW);
  if (PIN_BUZZER >= 0) {
    ledcAttach(PIN_BUZZER, 2000, 10);
    ledcWrite(PIN_BUZZER, 0);
  }
}

// Blocking beep (only used during setup, before flight). LED lights with the tone.
void beep(int freq, int ms) {
  digitalWrite(PIN_STATUS_LED, HIGH);
  if (PIN_BUZZER >= 0) ledcWriteTone(PIN_BUZZER, freq);
  delay(ms);
  if (PIN_BUZZER >= 0) ledcWriteTone(PIN_BUZZER, 0);
  digitalWrite(PIN_STATUS_LED, LOW);
}

void calibrateIMU() {
#if CALIB_ON_BOOT
  if (!imuOK) {
    Serial.println(F("[CAL] IMU missing - skipping calibration"));
    return;
  }

  Serial.println(F("[CAL] Keep the drone STILL and LEVEL for 5 seconds..."));
  beep(1500, 350);  // "starting" tone

  unsigned long start = millis(), lastBlink = 0;
  bool ledOn = false;
  double sgx = 0, sgy = 0, sgz = 0, sar = 0, sap = 0;
  long n = 0;
  float maxRate = 0;

  while (millis() - start < CALIB_MS) {
    sensors_event_t a, m, g, t;
    lsm.getEvent(&a, &m, &g, &t);
    float ax = a.acceleration.x - AX_OFFSET;
    float ay = a.acceleration.y - AY_OFFSET;
    float az = a.acceleration.z - AZ_OFFSET;
    float rx = g.gyro.y * 180.0 / PI;
    float ry = g.gyro.x * 180.0 / PI;
    float rz = g.gyro.z * 180.0 / PI;

    sgx += rx;
    sgy += ry;
    sgz += rz;
    sar += (atan2(ax, az) * 180.0 / PI);
    sap += (atan2(-ay, sqrt(ay * ay + az * az)) * 180.0 / PI);
    float mag = max(fabs(rx - (sgx / (n + 1))), max(fabs(ry - (sgy / (n + 1))), fabs(rz - (sgz / (n + 1)))));
    if (mag > maxRate) maxRate = mag;
    n++;

    if (millis() - lastBlink > 120) {
      ledOn = !ledOn;
      digitalWrite(PIN_STATUS_LED, ledOn);
      lastBlink = millis();
    }
    delay(5);
  }

  if (n > 0) {
    gyroBiasRoll = sgx / n;
    gyroBiasPitch = sgy / n;
    gyroBiasYaw = sgz / n;
    levelOffRoll = sar / n;   // resting roll  -> subtracted so level reads 0
    levelOffPitch = sap / n;  // resting pitch -> subtracted so level reads 0
  }

  // Reset the fused attitude to level and prime the PID derivative memory.
  angleRoll = 0;
  anglePitch = 0;
  pidRoll.prevMeas = 0;
  pidPitch.prevMeas = 0;
  pidYaw.prevMeas = 0;

  // Establish the yaw-zero reference from the current heading (one read with new offsets).
  readAttitude(0.01);
  yawRef = headingDeg;
  imuCalibrated = true;

  Serial.printf("[CAL] done  gyroBias=(%.2f,%.2f,%.2f) level=(%.2f,%.2f) yawRef=%.1f\n",
                gyroBiasRoll, gyroBiasPitch, gyroBiasYaw, levelOffRoll, levelOffPitch, yawRef);
  if (maxRate > CALIB_MOVE_GYRO_DPS)
    Serial.println(F("[CAL] WARNING: motion detected during calibration - power-cycle and keep it still."));

  // "Ready" signal: rising double beep + solid LED.
  beep(2000, 120);
  delay(70);
  beep(2600, 220);
  digitalWrite(PIN_STATUS_LED, HIGH);  // solid = ready to arm
#endif
}

/* =====================================================================================
 * 4. RECEIVER (iBUS)  --  decode sticks + switches, detect failsafe
 * ===================================================================================== */
void receiverSetup() {
  Serial2.begin(115200, SERIAL_8N1, PIN_RC_RX, PIN_RC_TX);
  ibus.begin(Serial2, IBUSBM_NOTIMER);  // NOTIMER: we pump it from loop() (no ISR crashes)
  lastRcFrameMs = millis();
}

// Map a receiver channel to a symmetric range about centre (e.g. -30..+30 degrees).
static float rcToRange(uint16_t v, float outAbs) {
  v = constrain(v, (uint16_t)RC_MIN, (uint16_t)RC_MAX);
  float norm = ((float)v - RC_MID) / ((RC_MAX - RC_MIN) / 2.0);  // -1..+1
  return norm * outAbs;
}

void readReceiver() {
  ibus.loop();  // must be called often in NOTIMER mode

  uint16_t rawThr = ibus.readChannel(CH_THROTTLE);
  uint16_t rawRoll = ibus.readChannel(CH_ROLL);
  uint16_t rawPit = ibus.readChannel(CH_PITCH);
  uint16_t rawYaw = ibus.readChannel(CH_YAW);
  uint16_t rawArm = ibus.readChannel(CH_ARM);
  uint16_t rawMode = ibus.readChannel(CH_MODE);

  // ---- Failsafe detection ----------------------------------------------------------
  // 1) A new frame updates ibus.cnt_rec. If it stops changing, the wire/RX died.
  if (ibus.cnt_rec != lastRcCnt) {
    lastRcCnt = ibus.cnt_rec;
    lastRcFrameMs = millis();
  }
  bool stale = (millis() - lastRcFrameMs) > RC_TIMEOUT_MS;

  // 2) Channels out of a sane window (0 == never received, >2100 == garbage/failsafe bits).
  bool outOfRange = (rawThr < RC_VALID_MIN || rawThr > RC_VALID_MAX || rawRoll == 0 || rawPit == 0 || rawYaw == 0);

  // 3) Transmitter-configured failsafe: throttle deliberately driven very low.
  bool tstFailsafe = (rawThr > 0 && rawThr < FAILSAFE_THROTTLE);

  rcFailsafe = stale || outOfRange || tstFailsafe;

  if (rcFailsafe) {
    // Safe defaults: no throttle, level sticks, treat arm switch as OFF.
    cmdThrottle = RC_MIN;
    cmdRoll = cmdPitch = cmdYawRate = 0;
    armSwitchHigh = false;
    modeSwitchAuto = false;
    return;
  }

  cmdThrottle = constrain((int)rawThr, RC_MIN, RC_MAX);
  cmdRoll = rcToRange(rawRoll, MAX_TILT_ANGLE_DEG);
  cmdPitch = rcToRange(rawPit, MAX_TILT_ANGLE_DEG);
  cmdYawRate = rcToRange(rawYaw, MAX_YAW_RATE_DPS);
  if (fabs(cmdYawRate) < (MAX_YAW_RATE_DPS * 0.03)) cmdYawRate = 0;  // small deadband
  armSwitchHigh = (rawArm > RC_MID);
  modeSwitchAuto = (rawMode > RC_MID);
}

/* =====================================================================================
 * 5. PID  --  stabilisation
 *  A generic PID helper is used for all three axes so the logic is written once.
 *   - roll/pitch: setpoint = desired ANGLE, measurement = estimated angle.
 *   - yaw:        setpoint = desired RATE,  measurement = gyro yaw rate.
 *  Includes: output clamp, integral clamp + anti-windup, and a low-pass filtered
 *  derivative-on-measurement (avoids derivative kick when the setpoint jumps).
 * ===================================================================================== */
float runPID(PID& s, float setpoint, float meas, float kp, float ki, float kd,
             float outLimit, float dt, bool allowIntegral) {
  float error = setpoint - meas;

  float P = kp * error;

  if (allowIntegral) s.integral += ki * error * dt;
  s.integral = constrain(s.integral, -I_LIMIT, I_LIMIT);
  float I = s.integral;

  // Derivative on measurement (not error) -> no spike when the pilot moves the stick.
  float dMeas = (meas - s.prevMeas) / dt;
  s.prevMeas = meas;
  s.dFilt = D_FILTER_ALPHA * dMeas + (1.0 - D_FILTER_ALPHA) * s.dFilt;
  float D = -kd * s.dFilt;

  float out = P + I + D;

  // Anti-windup: if we saturate, pull the overflow back out of the integrator.
  if (out > outLimit) {
    s.integral -= (out - outLimit);
    out = outLimit;
  } else if (out < -outLimit) {
    s.integral += (-outLimit - out);
    out = -outLimit;
  }
  return out;
}

void runStabiliser(float dt) {
  // Only wind up the integrators once we are armed AND above the hover-ish threshold,
  // so a small standing error on the bench cannot slowly ramp the motors.
  bool allowI = (flightState == ARMED) && (cmdThrottle > MOTOR_START_THROTTLE + 100);

  if (flightState != ARMED) {
    // Keep everything reset while disarmed so we start clean the moment we arm.
    pidRoll.integral = pidPitch.integral = pidYaw.integral = 0;
    outRoll = outPitch = outYaw = 0;
    pidRoll.prevMeas = angleRoll;
    pidPitch.prevMeas = anglePitch;
    pidYaw.prevMeas = gyroYaw;
    return;
  }

  outRoll = runPID(pidRoll, cmdRoll, angleRoll, ROLL_KP, ROLL_KI, ROLL_KD, PID_OUT_LIMIT, dt, allowI);
  outPitch = runPID(pidPitch, cmdPitch, anglePitch, PITCH_KP, PITCH_KI, PITCH_KD, PID_OUT_LIMIT, dt, allowI);
  outYaw = runPID(pidYaw, cmdYawRate, gyroYaw, YAW_KP, YAW_KI, YAW_KD, YAW_OUT_LIMIT, dt, allowI);
}

/* =====================================================================================
 * 6. MOTOR MIXER + ESC OUTPUT  (50 Hz, 11-bit)
 * ===================================================================================== */
void motorsSetup() {
  // ESP32 Arduino core v3.x API. (v2.x users: use ledcSetup(ch,freq,res)+ledcAttachPin.)
  ledcAttach(PIN_ESC_FL, ESC_FREQ_HZ, ESC_RESOLUTION);
  ledcAttach(PIN_ESC_FR, ESC_FREQ_HZ, ESC_RESOLUTION);
  ledcAttach(PIN_ESC_BR, ESC_FREQ_HZ, ESC_RESOLUTION);
  ledcAttach(PIN_ESC_BL, ESC_FREQ_HZ, ESC_RESOLUTION);
  writeAllMotors(ESC_MIN_TICK);  // send idle/arm pulse so ESCs initialise disarmed
}

void writeAllMotors(int ticks) {
  ledcWrite(PIN_ESC_FL, ticks);
  ledcWrite(PIN_ESC_FR, ticks);
  ledcWrite(PIN_ESC_BL, ticks);
  ledcWrite(PIN_ESC_BR, ticks);
}

// Convert a 1000..2000us throttle value to ESC duty ticks (102..205).
static int usToTicks(float us) {
  us = constrain(us, 1000.0f, 2000.0f);
  return (int)(us / 20000.0f * ESC_MAX_TICK_FS + 0.5f);
}

void mixAndWriteMotors() {
  if (flightState != ARMED) {
    writeAllMotors(ESC_MIN_TICK);
    motFL = motFR = motBL = motBR = ESC_MIN_TICK;
    return;
  }

  // Below the start threshold: keep motors at idle so they spin slowly / are ready,
  // but don't apply attitude corrections (prevents twitching on the ground).
  if (cmdThrottle < MOTOR_START_THROTTLE) {
    int idle = usToTicks(MOTOR_START_THROTTLE);
    motFL = motFR = motBL = motBR = idle;
    ledcWrite(PIN_ESC_FL, motFL);
    ledcWrite(PIN_ESC_FR, motFR);
    ledcWrite(PIN_ESC_BL, motBL);
    ledcWrite(PIN_ESC_BR, motBR);
    return;
  }

  float thr = cmdThrottle;
  float r = outRoll * MIX_ROLL_SIGN;
  float p = outPitch * MIX_PITCH_SIGN;
  float y = outYaw * MIX_YAW_SIGN;

  // X-quad mix (in throttle-us units). If an axis reacts backwards, flip its MIX_*_SIGN.
  float fFL = thr + p + r + y;
  float fFR = thr + p - r - y;
  float fBL = thr - p + r - y;
  float fBR = thr - p - r + y;

  // AIR-MODE style clamp: shift all motors together so the *differences* (attitude
  // authority) are preserved instead of individually clipping the low motor.
  float lo = min(min(fFL, fFR), min(fBL, fBR));
  float hi = max(max(fFL, fFR), max(fBL, fBR));
  if (lo < 990) {
    float s = 1000 - lo;
    fFL += s;
    fFR += s;
    fBL += s;
    fBR += s;
  }
  if (hi > 2100) {
    float s = hi - 2000;
    fFL -= s;
    fFR -= s;
    fBL -= s;
    fBR -= s;
  }

  motFL = usToTicks(fFL);
  motFR = usToTicks(fFR);
  motBL = usToTicks(fBL);
  motBR = usToTicks(fBR);

  ledcWrite(PIN_ESC_FL, motFL);
  ledcWrite(PIN_ESC_FR, motFR);
  ledcWrite(PIN_ESC_BL, motBL);
  ledcWrite(PIN_ESC_BR, motBR);
}

/* =====================================================================================
 * 7. GPS  --  non-blocking parse + telemetry
 *  IMPORTANT: never block the control loop. We only drain whatever bytes are waiting.
 * ===================================================================================== */
void gpsSetup() {
  gpsSerial.begin(GPS_BAUD, SERIAL_8N1, PIN_GPS_RX, PIN_GPS_TX);
}

void readGPS() {
  while (gpsSerial.available() > 0) gps.encode(gpsSerial.read());
  if (gps.location.isValid()) {
    gpsLat = gps.location.lat();
    gpsLng = gps.location.lng();
    gpsFix = true;
  } else {
    gpsFix = false;
  }
  if (gps.satellites.isValid()) gpsSats = gps.satellites.value();
}

/* =====================================================================================
 * 7b. BAROMETER  --  altitude above launch point + vertical speed
 * ===================================================================================== */
void baroSetup() {
  if (bmp.begin(BMP280_I2C_ADDR)) {
    baroOK = true;
    bmp.setSampling(Adafruit_BMP280::MODE_NORMAL, Adafruit_BMP280::SAMPLING_X2,
                    Adafruit_BMP280::SAMPLING_X16, Adafruit_BMP280::FILTER_X16,
                    Adafruit_BMP280::STANDBY_MS_1);
    Serial.println(F("[BARO] BMP280 OK"));
  } else {
    baroOK = false;
    Serial.println(F("[BARO] BMP280 not found (altitude hold disabled)"));
  }
}

// Reads at ~40 Hz (I2C is slow); altitudeM is metres ABOVE the baseline captured at arm.
void readBaro() {
  if (!baroOK) {
    altitudeM = 0;
    climbRateMps = 0;
    return;
  }
  static unsigned long lastMs = 0;
  unsigned long now = millis();
  if (now - lastMs < 25) return;
  float dt = (now - lastMs) / 1000.0;
  if (dt <= 0) dt = 0.025;
  lastMs = now;

  float raw = bmp.readAltitude(SEA_LEVEL_HPA);  // metres (absolute-ish)
  altitudeM = raw - homeAltRawM;                // relative to home
  float inst = (altitudeM - prevAltM) / dt;
  climbRateMps = 0.8 * climbRateMps + 0.2 * inst;  // low-pass the vertical speed
  prevAltM = altitudeM;
}

/* =====================================================================================
 * 7c. nRF24L01 RADIO LINK  --  receive waypoint commands, send telemetry
 *  Half-duplex: we listen for commands and briefly switch to TX to send telemetry.
 *  Packet layouts are defined at the top and MUST match the transmitter sketch.
 * ===================================================================================== */
void rfSetup() {
  SPI.begin(PIN_NRF_SCK, PIN_NRF_MISO, PIN_NRF_MOSI, PIN_NRF_CSN);
  if (!radio.begin()) {
    rfOK = false;
    Serial.println(F("[nRF] not responding (waypoint link disabled)"));
    return;
  }
  rfOK = true;
  radio.setPALevel(RF24_PA_LOW);    // use RF24_PA_HIGH/MAX with a good antenna module
  radio.setDataRate(RF24_250KBPS);  // slowest rate = best range/reliability
  radio.setRetries(3, 5);           // (delay, count) - keep TX time bounded
  radio.openWritingPipe(NRF_ADDR_TELEM);
  radio.openReadingPipe(1, NRF_ADDR_CMD);
  radio.startListening();
  Serial.println(F("[nRF] radio ready"));
}

void rfLoop() {
  if (!rfOK) return;

  // ---- Receive waypoint commands from the ground station ----
  if (radio.available()) {
    CommandPacket cp;
    radio.read(&cp, sizeof(cp));
    lastCmdMs = millis();
    if (cp.seq != lastCmdSeq) lastCmdSeq = cp.seq;  // fresh command
    if (cp.lat != 0 || cp.lng != 0) {               // valid coordinate
      targetLat = cp.lat / 1e7;
      targetLng = cp.lng / 1e7;
      targetAltM = cp.altM;
      haveWaypoint = true;
    }
  }

  // ---- Send telemetry back to the ground station ----
  if (millis() - lastTelemMs >= TELEM_INTERVAL_MS) {
    lastTelemMs = millis();
    TelemetryPacket tp;
    tp.mode = (uint8_t)navMode;
    tp.armed = (flightState == ARMED) ? 1 : 0;
    tp.roll = (int16_t)(angleRoll * 100);
    tp.pitch = (int16_t)(anglePitch * 100);
    tp.yaw = (int16_t)(reportedYaw * 100);  // yaw relative to power-on (0 at startup)
    tp.lat = (int32_t)(gpsLat * 1e7);
    tp.lng = (int32_t)(gpsLng * 1e7);
    tp.altDm = (int16_t)(altitudeM * 10);
    tp.sats = (uint8_t)gpsSats;
    tp.distM = (uint16_t)constrain(distToTargetM, 0.0f, 65535.0f);
    radio.stopListening();
    radio.write(&tp, sizeof(tp));
    radio.startListening();
  }
}

/* =====================================================================================
 * 7d. AUTONOMOUS NAVIGATION + FLIGHT-MODE STATE MACHINE
 * -------------------------------------------------------------------------------------
 *  navigateTo() converts a GPS target + altitude into the SAME command variables the RC
 *  sticks would set (cmdRoll/cmdPitch/cmdYawRate/cmdThrottle), so the existing stabiliser
 *  and mixer fly it. It turns the nose toward the target, leans forward to fly there, and
 *  uses the barometer + altitude PID to hold the requested height.
 *
 *  Modes (navMode):
 *    NAV_RC       - pilot has full stick control (default & failsafe).
 *    NAV_AUTO     - fly to the received waypoint (or hover in place if none yet).
 *    NAV_HANDOVER - AUTO->RC transition: hold position for HANDOVER_MS (10 s) so the
 *                   pilot has time to grab the controller, THEN hand control back to RC.
 *  The pilot's physical mode switch is always the master authority (safety).
 * ===================================================================================== */
void navigateTo(double tLat, double tLng, float tAltM, float dt) {
  if (gpsFix) {
    distToTargetM = TinyGPSPlus::distanceBetween(gpsLat, gpsLng, tLat, tLng);
    float bearing = TinyGPSPlus::courseTo(gpsLat, gpsLng, tLat, tLng);  // 0..360 toward target
    float herr = bearing - headingDeg;                                  // heading error
    while (herr > 180) herr -= 360;
    while (herr < -180) herr += 360;

    if (distToTargetM <= NAV_ARRIVAL_M) {
      cmdRoll = 0;
      cmdPitch = 0;
      cmdYawRate = 0;  // arrived -> hover
    } else {
      float herrRad = herr * PI / 180.0;
      float fwd = distToTargetM * cos(herrRad);   // component in front of the nose
      float side = distToTargetM * sin(herrRad);  // component to the side
      cmdPitch = NAV_PITCH_SIGN * constrain(NAV_KP_POS * fwd, -NAV_MAX_TILT_DEG, NAV_MAX_TILT_DEG);
      cmdRoll = NAV_ROLL_SIGN * constrain(NAV_KP_POS * side, -NAV_MAX_TILT_DEG, NAV_MAX_TILT_DEG);
      cmdYawRate = constrain(NAV_KP_YAW * herr, -MAX_YAW_RATE_DPS, MAX_YAW_RATE_DPS);  // turn toward target
    }
  } else {
    // No GPS fix: stay level, do not attempt horizontal motion.
    cmdRoll = 0;
    cmdPitch = 0;
    cmdYawRate = 0;
    distToTargetM = 0;
  }

  // Altitude hold -> throttle. runPID's derivative-on-measurement damps vertical speed.
  float altOut = runPID(pidAlt, tAltM, altitudeM, ALT_KP, ALT_KI, ALT_KD, ALT_I_LIMIT + 200.0, dt, true);
  cmdThrottle = constrain(HOVER_THROTTLE + (int)altOut, ALT_THROTTLE_MIN, ALT_THROTTLE_MAX);
}

void updateFlightMode() {
  if (flightState != ARMED) {
    navMode = NAV_RC;
    return;
  }

  // AUTONOMOUS requires the pilot's switch AND a GPS fix (never fly blind).
  bool autoAllowed = modeSwitchAuto && gpsFix;

  switch (navMode) {
    case NAV_RC:
      if (autoAllowed) {
        navMode = NAV_AUTO;
        pidAlt.integral = 0;
        pidAlt.prevMeas = altitudeM;
        pidAlt.dFilt = 0;  // clean altitude handoff
        if (!haveWaypoint) {
          holdLat = gpsLat;
          holdLng = gpsLng;
          holdAltM = altitudeM;
        }
      }
      break;

    case NAV_AUTO:
      if (!modeSwitchAuto) {  // pilot asked to return to RC
        navMode = NAV_HANDOVER;
        handoverStartMs = millis();
        holdLat = gpsLat;
        holdLng = gpsLng;
        holdAltM = altitudeM;  // freeze here and hover
        pidAlt.integral = 0;
        pidAlt.prevMeas = altitudeM;
        pidAlt.dFilt = 0;
      }
      break;

    case NAV_HANDOVER:
      if (modeSwitchAuto) {  // flipped back to AUTO -> cancel handover
        navMode = NAV_AUTO;
      } else if (millis() - handoverStartMs >= HANDOVER_MS) {
        navMode = NAV_RC;  // 10 s elapsed -> pilot now has the sticks
      }
      break;
  }
}

// Runs after readReceiver() (RC sticks) and updateFlightMode(). In AUTO/HANDOVER it
// OVERWRITES the stick commands with the navigation outputs.
void applyModeCommands(float dt) {
  switch (navMode) {
    case NAV_RC:
      // Keep the stick commands already decoded in readReceiver(). Nothing to do.
      break;
    case NAV_AUTO:
      if (haveWaypoint) navigateTo(targetLat, targetLng, targetAltM, dt);
      else navigateTo(holdLat, holdLng, holdAltM, dt);  // hover until a waypoint arrives
      break;
    case NAV_HANDOVER:
      navigateTo(holdLat, holdLng, holdAltM, dt);  // hold position for the pilot
      break;
  }
}

/* =====================================================================================
 * 8. SAFETY / ARMING STATE MACHINE
 *  Rules (all must be safe to fly):
 *    - To ARM: arm switch HIGH, throttle held LOW, IMU healthy, and no RC failsafe.
 *    - To DISARM (immediately): arm switch LOW, OR RC failsafe/timeout, OR tilt > cutoff.
 * ===================================================================================== */
void updateSafety() {
  bool tiltExceeded = (fabs(angleRoll) > SAFETY_TILT_CUTOFF_DEG || fabs(anglePitch) > SAFETY_TILT_CUTOFF_DEG);

  if (flightState == ARMED) {
    if (!armSwitchHigh) {
      flightState = DISARMED;
      stateReason = "arm switch off";
    } else if (rcFailsafe) {
      flightState = DISARMED;
      stateReason = "RC failsafe";
    } else if (tiltExceeded) {
      flightState = DISARMED;
      stateReason = "tilt cutoff";
    } else if (!imuOK) {
      flightState = DISARMED;
      stateReason = "IMU lost";
    }
  } else {  // DISARMED
    bool canArm = armSwitchHigh && !rcFailsafe && imuOK && (cmdThrottle <= ARMING_THROTTLE_MAX);
    if (canArm) {
      flightState = ARMED;
      stateReason = "armed";
      // Capture the launch altitude so altitude-hold is "metres above where I took off".
      if (baroOK) homeAltRawM = bmp.readAltitude(SEA_LEVEL_HPA);
      altitudeM = 0;
      prevAltM = 0;
      climbRateMps = 0;
      navMode = NAV_RC;  // always start a flight in RC mode
    }
  }
}

/* =====================================================================================
 * 9. DEBUG  --  toggleable serial inspection (see DEBUG_MODE at the top)
 * ===================================================================================== */
void printDebug() {
#if DEBUG_ENABLED
  if (millis() - lastDebugMs < DEBUG_INTERVAL_MS) return;
  lastDebugMs = millis();

  switch (DEBUG_MODE) {
    case DBG_RC:
      Serial.printf("RC  thr:%4d roll:%+6.1f pitch:%+6.1f yawRate:%+6.1f arm:%d FS:%d\n",
                    cmdThrottle, cmdRoll, cmdPitch, cmdYawRate, armSwitchHigh, rcFailsafe);
      break;
    case DBG_ATTITUDE:
      Serial.printf("ATT roll:%+7.2f pitch:%+7.2f yaw:%+7.2f (hdg:%5.1f) cal:%d\n",
                    angleRoll, anglePitch, reportedYaw, headingDeg, imuCalibrated);
      break;
    case DBG_PID:
      Serial.printf("PID outR:%+7.1f outP:%+7.1f outY:%+7.1f\n", outRoll, outPitch, outYaw);
      break;
    case DBG_MOTORS:
      Serial.printf("MOT FL:%4d FR:%4d BL:%4d BR:%4d (ticks)\n", motFL, motFR, motBL, motBR);
      break;
    case DBG_GPS:
      Serial.printf("GPS fix:%d sats:%d lat:%.6f lng:%.6f\n", gpsFix, gpsSats, gpsLat, gpsLng);
      break;
    case DBG_STATE:
      Serial.printf("STATE %-8s reason:%-16s thr:%4d FS:%d imu:%d\n",
                    flightState == ARMED ? "ARMED" : "DISARMED", stateReason,
                    cmdThrottle, rcFailsafe, imuOK);
      break;
    case DBG_NAV:
      Serial.printf("NAV %-8s wp:%d hdg:%5.1f alt:%6.2f dist:%6.1f tgt:%.6f,%.6f rf:%d\n",
                    navModeName(navMode), haveWaypoint, headingDeg, altitudeM,
                    distToTargetM, targetLat, targetLng, rfOK);
      break;
  }
#endif
}

/* =====================================================================================
 * 10. FLASH DATA LOGGER  (LittleFS on the ESP32's internal flash)
 * -------------------------------------------------------------------------------------
 *  Writes one CSV row every LOG_INTERVAL_MS with everything you need to debug a flight:
 *  the motor outputs, the roll/pitch/yaw estimates and commands, the PID outputs, arm
 *  state and GPS. Retrieve it over USB with the `dump` serial command (see config).
 *
 *  Design notes:
 *   - The file handle stays open in append mode; we only flush() every LOG_FLUSH_MS so
 *     flash writes are batched and don't stall the 250 Hz control loop.
 *   - When the file reaches LOG_MAX_BYTES we stop (keeping the earliest data) and tell
 *     you to `dump` then `erase`. This protects the flash and never blocks flight.
 * ===================================================================================== */
const char* LOG_HEADER =
  "ms,state,navmode,thr,cmdRoll,cmdPitch,cmdYawRate,roll,pitch,heading,gyroYaw,"
  "outRoll,outPitch,outYaw,mFL,mFR,mBL,mBR,alt,climb,failsafe,imu,gpsFix,sats,"
  "lat,lng,tgtLat,tgtLng,tgtAlt,dist";

void loggerSetup() {
#if LOG_ENABLED
  // format-on-fail = true: if the flash has never held a filesystem, make one.
  if (!LittleFS.begin(true)) {
    Serial.println(F("[LOG] LittleFS mount FAILED - logging disabled"));
    logMounted = false;
    return;
  }
  logMounted = true;

  // If the file doesn't exist yet, create it and write the CSV header row.
  bool needHeader = !LittleFS.exists(LOG_FILE_PATH);
  logFile = LittleFS.open(LOG_FILE_PATH, needHeader ? "w" : "a");
  if (!logFile) {
    Serial.println(F("[LOG] could not open log file"));
    logMounted = false;
    return;
  }
  if (needHeader) {
    logFile.println(LOG_HEADER);
    logFile.flush();
  }

  logFull = (logFile.size() >= LOG_MAX_BYTES);
  loggingOn = !logFull;
  Serial.printf("[LOG] ready: %s (%u bytes). Type 'help' over USB for commands.\n",
                LOG_FILE_PATH, (unsigned)logFile.size());
#endif
}

void logData() {
#if LOG_ENABLED
  if (!logMounted || !loggingOn || logFull) return;
  if (LOG_ONLY_WHEN_ARMED && flightState != ARMED) return;
  if (millis() - lastLogMs < LOG_INTERVAL_MS) return;
  lastLogMs = millis();

  if (logFile.size() >= LOG_MAX_BYTES) {
    logFull = true;
    loggingOn = false;
    logFile.flush();
    Serial.println(F("[LOG] file full - stopped. Use 'dump' then 'erase'."));
    return;
  }

  // One CSV row. printf keeps this compact and fast.
  logFile.printf("%lu,%s,%s,%d,%.1f,%.1f,%.1f,%.2f,%.2f,%.1f,%.2f,%.1f,%.1f,%.1f,"
                 "%d,%d,%d,%d,%.2f,%.2f,%d,%d,%d,%d,%.6f,%.6f,%.6f,%.6f,%.1f,%.1f\n",
                 millis(),
                 (flightState == ARMED) ? "ARMED" : "DISARM",
                 navModeName(navMode),
                 cmdThrottle, cmdRoll, cmdPitch, cmdYawRate,
                 angleRoll, anglePitch, headingDeg, gyroYaw,
                 outRoll, outPitch, outYaw,
                 motFL, motFR, motBL, motBR,
                 altitudeM, climbRateMps,
                 rcFailsafe ? 1 : 0, imuOK ? 1 : 0,
                 gpsFix ? 1 : 0, gpsSats, gpsLat, gpsLng,
                 targetLat, targetLng, targetAltM, distToTargetM);

  if (millis() - lastFlushMs >= LOG_FLUSH_MS) {
    logFile.flush();
    lastFlushMs = millis();
  }
#endif
}

void dumpLog() {
#if LOG_ENABLED
  if (!logMounted) {
    Serial.println(F("[LOG] not mounted"));
    return;
  }
  logFile.flush();  // make sure buffered rows are on flash
  File f = LittleFS.open(LOG_FILE_PATH, "r");
  if (!f) {
    Serial.println(F("[LOG] cannot open for read"));
    return;
  }
  Serial.println(F("----- BEGIN FLIGHT LOG -----"));
  while (f.available()) Serial.write(f.read());
  Serial.println(F("------ END FLIGHT LOG ------"));
  f.close();
#endif
}

void eraseLog() {
#if LOG_ENABLED
  if (logFile) logFile.close();
  LittleFS.remove(LOG_FILE_PATH);
  logFile = LittleFS.open(LOG_FILE_PATH, "w");
  if (logFile) {
    logFile.println(LOG_HEADER);
    logFile.flush();
  }
  logFull = false;
  loggingOn = true;
  Serial.println(F("[LOG] erased - fresh log started"));
#endif
}

// Reads single-line commands from the USB serial monitor (see config for the list).
void handleSerialCommands() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      if (serialCmdLen == 0) continue;
      serialCmd[serialCmdLen] = '\0';
      for (uint8_t i = 0; i < serialCmdLen; i++) serialCmd[i] = tolower(serialCmd[i]);

      if (!strcmp(serialCmd, "help")) {
        Serial.println(F("Commands: help | dump | size | erase | stop | start | cal | reboot"));
      } else if (!strcmp(serialCmd, "cal") || !strcmp(serialCmd, "recal")) {
        Serial.println(F("[SYS] Re-running IMU calibration... Keep drone STILL and LEVEL"));
        calibrateIMU();
      } else if (!strcmp(serialCmd, "reboot") || !strcmp(serialCmd, "reset")) {
        Serial.println(F("[SYS] Rebooting ESP32..."));
        delay(100);
        ESP.restart(); // Performs software reboot equivalent to pressing EN button
      } else if (!strcmp(serialCmd, "dump")) {
        dumpLog();
      } else if (!strcmp(serialCmd, "erase")) {
        eraseLog();
      } else if (!strcmp(serialCmd, "size")) {
        Serial.printf("[LOG] %u bytes (max %u)\n",
                      logMounted ? (unsigned)logFile.size() : 0, (unsigned)LOG_MAX_BYTES);
      } else if (!strcmp(serialCmd, "stop")) {
        loggingOn = false;
        Serial.println(F("[LOG] paused"));
      } else if (!strcmp(serialCmd, "start")) {
        if (logFull) Serial.println(F("[LOG] file full - erase first"));
        else {
          loggingOn = true;
          Serial.println(F("[LOG] resumed"));
        }
      } else {
        Serial.printf("[LOG] unknown '%s' (try help)\n", serialCmd);
      }

      serialCmdLen = 0;
    } else if (serialCmdLen < sizeof(serialCmd) - 1) {
      serialCmd[serialCmdLen++] = c;
    }
  }
}

/* =====================================================================================
 * 11. setup() / loop()
 * ===================================================================================== */
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println(F("\n=== My-Dro flight controller booting ==="));

  signalSetup();  // LED + optional buzzer ready for status tones

  // Motors FIRST so ESCs get their idle pulse immediately on power-up.
  motorsSetup();
  Serial.println(F("[1/4] ESCs @50Hz/11-bit initialised (idle)"));

  receiverSetup();
  Serial.println(F("[2/4] iBUS receiver initialised"));

  gpsSetup();
  Serial.println(F("[3/4] GPS serial initialised"));

  Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL);
  Wire.setClock(400000);
  sensorsSetup();
  baroSetup();
  Serial.println(F("[4/6] IMU + barometer setup done"));

  // Zero the axes now (drone must be sitting still & level). Beeps/LED indicate progress.
  calibrateIMU();

  rfSetup();
  Serial.println(F("[5/6] nRF24 waypoint link setup done"));

  loggerSetup();
  Serial.println(F("[6/6] logger ready"));

  Serial.println(F("Ready. Hold throttle LOW and flip ARM switch to arm.\n"));
  lastControlUs = micros();
}

void loop() {
  // Pump the receiver, GPS and radio every pass so no bytes/packets are lost.
  ibus.loop();
  readGPS();
  readBaro();              // self-throttled to ~40 Hz internally
  rfLoop();                // waypoint in / telemetry out
  handleSerialCommands();  // respond to USB commands (dump/erase/etc) any time

  // Fixed-rate control loop (250 Hz). Everything time-sensitive runs here.
  unsigned long now = micros();
  if (now - lastControlUs >= CONTROL_INTERVAL_US) {
    loopDtSec = (now - lastControlUs) / 1000000.0;
    if (loopDtSec <= 0) loopDtSec = CONTROL_INTERVAL_US / 1000000.0;
    lastControlUs = now;

    readReceiver();                // decode sticks + failsafe (also sets RC command values)
    readAttitude(loopDtSec);       // fuse IMU into roll/pitch + compass heading
    updateSafety();                // arm/disarm/kill decisions
    updateFlightMode();            // RC / AUTO / 10 s HANDOVER state machine
    applyModeCommands(loopDtSec);  // in AUTO/HANDOVER, override sticks with navigation
    runStabiliser(loopDtSec);      // PID
    mixAndWriteMotors();           // drive the ESCs

    logData();  // append a CSV row to flash (batched writes)
    printDebug();
  }
}
